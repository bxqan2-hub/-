{
  "manifest_version": 3,
  "name": "Roxy Profile Noise",
  "version": "1.0.0",
  "description": "Per-profile canvas / audio noise applied on readback, in the MAIN world.",
  "background": { "service_worker": "bg.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "<all_urls>"],
      "js": ["noise.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    }
  ]
}
