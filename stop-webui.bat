@echo off
setlocal EnableExtensions
cd /d "%~dp0"
rem Without an argument stop this project's WebUI on any port.
rem With a port also force-replace its listener, as requested by the launcher.
set "WEBUI_REPLACE_PORT=%~1"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $root=(Get-Location).Path; $entry=[regex]::Escape((Join-Path $root 'web.py')); $python=[regex]::Escape((Join-Path $root '.venv\Scripts\python.exe')); $port=0; if($env:WEBUI_REPLACE_PORT){if($env:WEBUI_REPLACE_PORT -notmatch '^\d{1,5}$' -or -not [int]::TryParse($env:WEBUI_REPLACE_PORT,[ref]$port) -or $port -lt 1 -or $port -gt 65535){throw 'Invalid replacement port'}}; $project=@(Get-CimInstance Win32_Process | Where-Object {$_.Name -match '^python(w)?\.exe$' -and ($_.CommandLine -match ('(?:^|\s|\x22)'+$entry+'(?:\s|\x22|$)') -or ($_.CommandLine -match $python -and $_.CommandLine -match '(?:^|\s|\x22)web\.py(?:\s|\x22|$)'))}); $owners=@($project | Select-Object -ExpandProperty ProcessId); if($port){$owners+=@(Get-NetTCPConnection -LocalPort $port -State Listen -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess)}; foreach($owner in @($owners | Sort-Object -Unique)){if($owner -le 4 -or $owner -eq $PID){throw 'Protected listener; no process was targeted'}; if(Get-Process -Id $owner -ErrorAction SilentlyContinue){Stop-Process -Id $owner -Force; Wait-Process -Id $owner -Timeout 10 -ErrorAction SilentlyContinue; Write-Host ('Stopped PID='+$owner)}}; if($port){$deadline=[datetime]::UtcNow.AddSeconds(10); do {$remaining=@(Get-NetTCPConnection -LocalPort $port -State Listen -ErrorAction SilentlyContinue); if(-not $remaining){break}; Start-Sleep -Milliseconds 200} while([datetime]::UtcNow -lt $deadline); if($remaining){$live=@($remaining | Where-Object {Get-Process -Id $_.OwningProcess -ErrorAction SilentlyContinue}); if(-not $live){Write-Host ('Orphaned listener remains on port '+$port); exit 2}; throw 'Listener persisted after forced stop'}}; $pidFile=Join-Path $root 'run\webui.pid'; if(Test-Path -LiteralPath $pidFile){Remove-Item -LiteralPath $pidFile -Force}; Write-Host 'WebUI stopped.'"
exit /b %errorlevel%
